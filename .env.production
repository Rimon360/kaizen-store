# The store only ever calls the backend's PUBLIC /api/store/* routes, so unlike
# the admin panel it needs no API/HMAC secret — never add one here: everything in
# a VITE_ variable ships to every visitor's browser.
VITE_BACKEND_URL=https://www.kaizzen.org/s/vHwxhS39x9wSS393xxhS3xhS9wxwxx3hh9wx9wxhS39

# Serving the store from a folder of an existing domain instead of its own?
# e.g. https://www.kaizzen.org/store/ → uncomment:
# VITE_BASE_PATH=/store/
